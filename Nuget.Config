<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Only use nuget.org - <clear /> stops this from merging with machine/user-level sources (e.g. a "github" feed) -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

