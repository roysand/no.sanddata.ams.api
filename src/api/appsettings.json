{
  "JwtSettings": {
    "Issuer": "AmsApi",
    "Audience": "AmsClient",
    "AccessTokenExpirationHours": 6,
    "RefreshTokenExpirationDays": 14
  },
  "NorgesPris": {
    "RatePerKwh": 0.40,
    "TaxPerKwh": 0
  },
  "RunMigrationsAtStartup": true,
  "Bootstrap": {
    "OwnerEmail": "roy@sanddata.no"
  },
  "PriceFetch": {
    "IntervalHours": 6
  },
  "EntsoE": {
    "SecurityToken": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "UseUtcTimestamp": false
      }
    }
  },
  "RequestLogging": {
    "AttributesToLog": [ "Path", "Method" ],
    "MaskValue": "***",
    "LogRequestBody": false,
    "LogResponseBody": false
  },
  "AllowedHosts": "*"
}
