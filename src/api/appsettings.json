{
  "JwtSettings": {
    "Issuer": "AmsApi",
    "Audience": "AmsClient",
    "AccessTokenExpirationHours": 6,
    "RefreshTokenExpirationDays": 14
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RequestLogging": {
    "AttributesToLog": [ "Path", "Method" ],
    "MaskValue": "***",
    "LogRequestBody": false,
    "LogResponseBody": false
  },
  "AllowedHosts": "*"
}
