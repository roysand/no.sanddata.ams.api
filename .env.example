# Copy to .env next to compose.prod.yaml on the server and fill in real values.
# .env is git-ignored — never commit it.

# Docker Hub account that owns the ams-api image
DOCKERHUB_USERNAME=<your-dockerhub-username>

# Postgres password (used by the db service and in DB_CONNECTION_STRING below)
POSTGRES_PASSWORD=<choose-a-strong-password>

# Server must be the compose service name (postgres); user/database match the postgres service
DB_CONNECTION_STRING=Server=postgres;Port=5432;Database=appdb;User Id=appuser;Password=<same-as-POSTGRES_PASSWORD>;

# JWT settings — generate the key with: openssl rand -base64 48
JWT_SECRET_KEY=<at-least-32-characters-random-string>
JWT_ISSUER=AmsApi
JWT_AUDIENCE=AmsApiClients
